<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Pb.Monitor/Theme/NoktraTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!--
    Typography.

    The instrument feel comes from a very wide range of type sizes: 9px letterspaced micro-labels
    doing all the annotation work, and one big bold title per panel. Everything in between is
    deliberately quiet.
  -->

  <!-- 9px uppercase annotation. The workhorse of the whole look. -->
  <Style Selector="TextBlock.micro">
    <Setter Property="FontFamily" Value="{StaticResource NoktraSans}" />
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="1.7" />
    <Setter Property="Foreground" Value="{StaticResource NoktraMuted}" />
  </Style>

  <Style Selector="TextBlock.micro-ink">
    <Setter Property="Foreground" Value="{StaticResource NoktraInkSoft}" />
  </Style>

  <Style Selector="TextBlock.micro-accent">
    <Setter Property="Foreground" Value="{StaticResource NoktraAccent}" />
  </Style>

  <Style Selector="TextBlock.micro-onink">
    <Setter Property="Foreground" Value="{StaticResource NoktraOnInkMuted}" />
  </Style>

  <!-- Numeric read-outs: monospace so columns of figures line up. -->
  <Style Selector="TextBlock.readout">
    <Setter Property="FontFamily" Value="{StaticResource NoktraMono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource NoktraInkSoft}" />
  </Style>

  <Style Selector="TextBlock.readout-lg">
    <Setter Property="FontFamily" Value="{StaticResource NoktraMono}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{StaticResource NoktraInk}" />
  </Style>

  <Style Selector="TextBlock.readout-muted">
    <Setter Property="Foreground" Value="{StaticResource NoktraMuted}" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontFamily" Value="{StaticResource NoktraSans}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.6" />
    <Setter Property="Foreground" Value="{StaticResource NoktraOnInk}" />
  </Style>

  <!-- The oversized, almost invisible panel watermark. -->
  <Style Selector="TextBlock.ghost">
    <Setter Property="FontFamily" Value="{StaticResource NoktraSans}" />
    <Setter Property="FontSize" Value="58" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-2" />
    <Setter Property="Foreground" Value="#12000000" />
  </Style>

  <!-- Surfaces -->

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource NoktraPanel}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource NoktraPanelEdge}" />
    <Setter Property="BoxShadow" Value="0 16 34 -12 #45000000" />
  </Style>

  <Style Selector="Border.sunk">
    <Setter Property="Background" Value="{StaticResource NoktraPanelSunk}" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>

  <!-- Any black chip: it names something. -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{StaticResource NoktraInk}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="8,3" />
  </Style>

  <Style Selector="Border.chip-accent">
    <Setter Property="Background" Value="{StaticResource NoktraAccent}" />
  </Style>

  <Style Selector="Border.chip-alert">
    <Setter Property="Background" Value="{StaticResource NoktraAlert}" />
  </Style>

  <Style Selector="Border.chip-outline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource NoktraLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="8,3" />
  </Style>

  <!-- Hairline used as a divider. -->
  <Style Selector="Rectangle.rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Fill" Value="{StaticResource NoktraLineFaint}" />
  </Style>

  <!-- A thick dashed line reads as a tick ruler, which is most of the reference's texture. -->
  <Style Selector="Line.ticks">
    <Setter Property="Stroke" Value="{StaticResource NoktraLine}" />
    <Setter Property="StrokeThickness" Value="7" />
    <Setter Property="StrokeDashArray" Value="0.14,0.72" />
  </Style>

  <Style Selector="Line.ticks-ink">
    <Setter Property="Stroke" Value="{StaticResource NoktraInkSoft}" />
  </Style>

  <!--
    One row of the dark statistic table: left label, right-aligned value. The signature element of
    the reference, and the right home for bridge totals.
  -->
  <Style Selector="Border.statrow">
    <Setter Property="Background" Value="{StaticResource NoktraInk}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>

  <Style Selector="Border.statrow TextBlock.k">
    <Setter Property="FontFamily" Value="{StaticResource NoktraSans}" />
    <Setter Property="FontSize" Value="9" />
    <Setter Property="LetterSpacing" Value="1.4" />
    <Setter Property="Foreground" Value="{StaticResource NoktraOnInkMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.statrow TextBlock.v">
    <Setter Property="FontFamily" Value="{StaticResource NoktraMono}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource NoktraOnInk}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A roster row: a sunk surface carrying one route or one endpoint. -->
  <Style Selector="Border.roster">
    <Setter Property="Background" Value="{StaticResource NoktraPanelSunk}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="11,7" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

</Styles>
